# Public — safe to expose in the browser bundle
VITE_API_BASE=https://<project-ref>.supabase.co/functions/v1/api
VITE_SUPABASE_ANON_KEY=<anon-key>

# Backend only — set with `npx supabase secrets set …`, never with a VITE_ prefix.
# XAI_API_KEY=xai-…
# IP_HASH_SALT=<32 random hex characters, e.g. `openssl rand -hex 16`>
# GROK_MODEL=grok-4-fast-non-reasoning   # optional override
